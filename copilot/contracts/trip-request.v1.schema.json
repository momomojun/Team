{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/momomojun/Team/blob/main/copilot/contracts/trip-request.v1.schema.json",
  "title": "TripRequest",
  "description": "Copilot → plan_trip 工具的输入，和网站自动生成攻略的表单一一对应",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "parks",
    "days",
    "origin"
  ],
  "anyOf": [
    {
      "required": [
        "startDate"
      ]
    },
    {
      "required": [
        "month"
      ]
    }
  ],
  "properties": {
    "contract": {
      "const": "trip-request/v1"
    },
    "parks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "acad",
          "ante",
          "arch",
          "badl",
          "banf",
          "bibe",
          "bisc",
          "blca",
          "brca",
          "cany",
          "care",
          "cave",
          "chir",
          "chis",
          "cong",
          "crla",
          "cuva",
          "dena",
          "deva",
          "drto",
          "ever",
          "gaar",
          "glac",
          "glba",
          "grba",
          "grca",
          "grsa",
          "grsm",
          "grte",
          "gumo",
          "hale",
          "havo",
          "hosp",
          "hsbd",
          "indu",
          "isro",
          "jasp",
          "jeff",
          "jotr",
          "katm",
          "kefj",
          "kova",
          "lacl",
          "lavo",
          "maca",
          "meve",
          "mora",
          "mova",
          "neri",
          "noca",
          "npsa",
          "olym",
          "pefo",
          "pinn",
          "redw",
          "romo",
          "sagu",
          "seki",
          "shen",
          "thro",
          "viis",
          "voya",
          "wave",
          "whsa",
          "wica",
          "wrst",
          "yell",
          "yoho",
          "yose",
          "zion"
        ]
      }
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "origin": {
      "$ref": "#/$defs/place"
    },
    "destination": {
      "$ref": "#/$defs/place"
    },
    "pace": {
      "enum": [
        "relaxed",
        "normal",
        "packed"
      ]
    },
    "lodgingPref": {
      "enum": [
        "any",
        "hotel",
        "rental",
        "camp"
      ]
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "youngestKid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17
        },
        "stroller": {
          "type": "boolean"
        },
        "seniors": {
          "type": "boolean"
        },
        "wheelchair": {
          "type": "boolean"
        }
      }
    },
    "include": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{4}-[a-z0-9-]+$"
      }
    },
    "exclude": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{4}-[a-z0-9-]+$"
      }
    },
    "lodging": {
      "type": "array",
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "night",
          "id"
        ],
        "properties": {
          "night": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z]{4}-stay-[a-z0-9-]+$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "parks",
          "startDate",
          "month",
          "days",
          "origin",
          "destination",
          "pace",
          "lodgingPref",
          "party",
          "include",
          "exclude",
          "lodging"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/fieldSource"
      }
    }
  },
  "$defs": {
    "place": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "airport"
          ],
          "properties": {
            "airport": {
              "enum": [
                "ABQ",
                "ACV",
                "ALS",
                "ANC",
                "ATL",
                "AUS",
                "AVL",
                "BGR",
                "BHB",
                "BIL",
                "BIS",
                "BLI",
                "BNA",
                "BOS",
                "BUR",
                "BZN",
                "CAE",
                "CAK",
                "CEC",
                "CHO",
                "CHS",
                "CLE",
                "CLT",
                "CMX",
                "CNM",
                "CNY",
                "COD",
                "COS",
                "CRW",
                "DCA",
                "DEN",
                "DIK",
                "DLH",
                "DRO",
                "ELP",
                "EUG",
                "EYW",
                "FAI",
                "FAT",
                "FCA",
                "FLG",
                "FLL",
                "GJT",
                "GST",
                "GTF",
                "GUC",
                "HOM",
                "IAD",
                "IDA",
                "INL",
                "ITO",
                "JAC",
                "KOA",
                "LAS",
                "LAX",
                "LIT",
                "LWB",
                "MAF",
                "MDW",
                "MEM",
                "MFR",
                "MIA",
                "MQT",
                "MRY",
                "MSO",
                "MSP",
                "MTJ",
                "OAK",
                "OGG",
                "ONT",
                "ORD",
                "OTZ",
                "PAE",
                "PDX",
                "PGA",
                "PHX",
                "PPG",
                "PSP",
                "PWM",
                "RAP",
                "RDD",
                "RDM",
                "RNO",
                "ROA",
                "RSW",
                "SAT",
                "SBA",
                "SDF",
                "SEA",
                "SFO",
                "SGU",
                "SJC",
                "SLC",
                "SMF",
                "SNA",
                "STL",
                "STT",
                "TUS",
                "TYS",
                "WYS",
                "XWA",
                "YEG",
                "YVR",
                "YYC"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "lat",
            "lon"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      ]
    },
    "fieldSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "user",
            "user_confirmation",
            "default",
            "inferred"
          ]
        },
        "evidence": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
