# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# 由 scripts/copy-maplibre-worker.mjs 在 dev / build 前复制
/public/maplibre/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# copilot (Python)
copilot/runs/
copilot/eval/reports/
__pycache__/
*.egg-info/
.pytest_cache/

# 每天抓的 NPS 公告快照和提取结果（评测用的快照在 copilot/eval/alerts/，要提交）
copilot/data/alerts/

# 讲解配音的本机模型（Kokoro，几百 MB，按 docs/COPILOT.md 下载）和生成过的语音
copilot/models/
copilot/data/tts/

# 评测记到 MLflow 的本机记录（copilot/eval/tracking.py）、LangGraph 的对话存档
copilot/mlruns/
copilot/data/sessions.sqlite*
copilot/data/chroma/
